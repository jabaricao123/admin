# Supabase 远端项目环境变量
# 在 Supabase Dashboard → Project Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://mnhtuekkxiqsseoesjfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 服务端专用（Server Action 调 Auth Admin API ban/unban 用户）；
# 绝不加 NEXT_PUBLIC 前缀，勿暴露给浏览器
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
