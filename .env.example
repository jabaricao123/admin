# Supabase 远端项目环境变量
# 在 Supabase Dashboard → Project Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://mnhtuekkxiqsseoesjfn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 服务端专用（Server Action 调 Auth Admin API ban/unban 用户）；
# 绝不加 NEXT_PUBLIC 前缀，勿暴露给浏览器
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# IM 扫码登录：公网回调域名（ADR-003 §6 部署硬前提，必须公网可达的 HTTPS 域名）
# 飞书开发者后台 → 安全设置 → 重定向 URL 需登记：<base>/auth/callback/feishu
# 本地真实联调可配隧道域名（如 https://xxx.trycloudflare.com）
NEXT_PUBLIC_IM_CALLBACK_BASE=https://your-domain.example.com

# IM 后端最小角色 JWT（role=im_backend，仅可执行 im_start_auth / im_handle_callback；
# 厂商凭据解密与出站均在 Postgres 内，secret 不出库）。
# 签发：SUPABASE_JWT_SECRET=<项目 JWT secret> npm run im:backend-token
IM_BACKEND_JWT=your-im-backend-jwt
